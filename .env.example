# ─────────────────────────────────────────────────────────────────────────────
# LOGMAS frontend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Build-time values (NEXT_PUBLIC_*) are inlined per deployment — one build
# per LGA.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash) — used for verification links, receipts
NEXT_PUBLIC_BASE_URL=https://www.example-lga.gov.ng

# Backend API base URL for this LGA's backend instance
NEXT_PUBLIC_API_BASE_URL=https://api.example-lga.logmas.com.ng/api/v1

# Payment provider: "gpay" (default) or "paystack"
NEXT_PUBLIC_PAYMENT_PROVIDER=gpay

# Optional OAuth (Google sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
